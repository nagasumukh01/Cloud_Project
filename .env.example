# TrustProof-Cloud - example environment file.
# Copy to .env and fill in. NEVER commit .env. All values below are placeholders.

# --- deployment -----------------------------------------------------------
TPC_ENV=local
TPC_DATA_DIR=./data
TPC_DATABASE_URL=sqlite:///./data/trustproof.db
TPC_KEYSTORE_DIR=./data/keys

# --- security (REQUIRED in any non-local deployment) -----------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TPC_REQUIRE_AUTH=true
TPC_API_KEY=replace-me-with-a-random-32-byte-token
TPC_ADMIN_API_KEY=replace-me-with-a-different-random-token

# AES-256 key for artifact encryption at rest (64 hex chars).
# Generate with:  python -c "import os; print(os.urandom(32).hex())"
# There is no default. Leaving it unset disables artifact encryption features.
TPC_ARTIFACT_KEY=

# --- freshness / replay protection ------------------------------------------
TPC_MAX_AGE_S=300
TPC_SKEW_S=30

# --- scheduling / fault tolerance --------------------------------------------
TPC_TASK_TIMEOUT_MS=5000
TPC_MAX_RETRIES=2
TPC_MAX_REPLICAS=3

# --- adaptive verification policy (swept in the M6 ablation study) ------------
TPC_RISK_LOW=0.25
TPC_RISK_HIGH=0.60
TPC_EXPLORE=0.05
TPC_TRUST_ALPHA=0.15
TPC_TRUST_PRIOR=0.70
TPC_TRUST_FLOOR=0.25

# --- reproducibility ------------------------------------------------------------
TPC_SEED=42

# --- M3+ infrastructure (local containers only; no paid services) ----------------
# REDIS_URL=redis://localhost:6379/0
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
